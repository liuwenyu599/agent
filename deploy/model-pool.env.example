# 多模型实例 / 负载均衡（第 8 项）
#
# 约束：一个 *_URLS 池内必须是“同一模型、同一 OpenAI-compatible 契约”的副本。
# 不要把 Qwen2.5-14B 与 DeepPresenter-9B 混在同一个池里；不同模型应使用各自池。
# 真实 NPU 卡号、端口和启动命令按部署机实际情况设置，本文件不假定硬件拓扑。

# 主文本模型：未设置 MODEL_SERVICE_URLS 时继续只用 MODEL_SERVICE_URL，完全向后兼容。
MODEL_SERVICE_URL=http://127.0.0.1:8001/v1
MODEL_SERVICE_URLS=http://127.0.0.1:8001/v1,http://127.0.0.1:8005/v1
MODEL_NAME=Qwen2.5-14B-Instruct

# PPT 专用模型也支持副本池；未设置 PPT_MODEL_URLS 时继续只用 PPT_MODEL_URL。
PPT_MODEL_URL=http://127.0.0.1:8010/v1
PPT_MODEL_URLS=http://127.0.0.1:8010/v1,http://127.0.0.1:8011/v1
PPT_MODEL_NAME=DeepPresenter-9B

# 主动 health() 探针超时，以及被动故障后的短暂熔断窗口。
MODEL_HEALTH_TIMEOUT=5
MODEL_FAILOVER_COOLDOWN=15

# 行为：
# 1. 正常请求按“最少在途请求 + 轮转打散”分配；
# 2. ConnectionError / Timeout / HTTP 429 / 5xx 自动切换下一副本；
# 3. HTTP 4xx 参数错误不会换节点重复打流量；
# 4. 所有节点失败时才向上返回 AIServiceError；
# 5. QwenGateway.health() 会逐个 GET <endpoint>/models，用于上线前/巡检探活。
