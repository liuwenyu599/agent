# 多模型实例 / 负载均衡（第 8 项）
#
# 约束：一个 *_URLS 池内必须是“同一模型、同一 OpenAI-compatible 契约”的副本。
# 不要把 Qwen2.5-14B 与 DeepPresenter-9B 混在同一个池里；不同模型使用各自池。
#
# 目标机已知备用 Ascend 设备：davinci0 / davinci1 / davinci5 / davinci6 / davinci7。
# 本仓库不会猜测现有主实例占卡；新增实例只从上述备用集合显式分配。启动前必须先
# `npu-smi info` + 端口检查。deploy/ascend-model-pool.sh 默认 dry-run，APPLY=1 才启动。

# 主文本模型。现有主实例 8003 + 新的同模型副本 8005。
MODEL_SERVICE_URL=http://10.128.85.133:8003/v1
MODEL_SERVICE_URLS=http://10.128.85.133:8003/v1,http://10.128.85.133:8005/v1
MODEL_NAME=Qwen2.5-14B-Instruct
# 建议新增第二个 14B 使用备用 0,1；如现场显存/拓扑不同，通过脚本环境变量覆盖。
TEXT_REPLICA_DEVICES=0,1
TEXT_REPLICA_PORT=8005
TEXT_TP_SIZE=2

# PPT 专用模型。现有主实例 8004 + 可选副本 8006。
PPT_MODEL_URL=http://10.128.85.133:8004/v1
PPT_MODEL_URLS=http://10.128.85.133:8004/v1,http://10.128.85.133:8006/v1
PPT_MODEL_NAME=DeepPresenter-9B
# 默认示例使用备用 5,6；davinci7 保留给视觉模型/第三实例/故障迁移。
PPT_REPLICA_DEVICES=5,6
PPT_REPLICA_PORT=8006
PPT_TP_SIZE=2

# 主动 health() 探针超时，以及被动故障后的短暂熔断窗口。
MODEL_HEALTH_TIMEOUT=5
MODEL_FAILOVER_COOLDOWN=15
# 单进程模型请求并发上限；端点池内部再按最少在途请求分配。
MODEL_MAX_CONCURRENCY=4

# 行为：
# 1. 正常请求按“最少在途请求 + 轮转打散”分配；
# 2. ConnectError / Timeout / HTTP 429 / 5xx 自动切换下一副本；
# 3. HTTP 4xx 参数错误不会换节点重复打流量；
# 4. 所有节点失败时才向上返回 AIServiceError；
# 5. QwenGateway.ahealth()/health() 会逐个 GET <endpoint>/models；
# 6. URL 池只声明“已经探活通过”的实例。未启动 8005/8006 时不要提前写入生产 .env。
