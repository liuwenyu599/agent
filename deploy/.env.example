# =============================================================================
# 智慧司法办公平台 · 生产环境变量样例
# 复制：cp .env.example .env，然后修改所有“请修改”项
# 警告：.env 含数据库口令与 JWT 密钥，禁止提交到代码仓库
# =============================================================================

# ---- 版本 ----
APP_VERSION=2.6.1

# ---- 对外端口 ----
API_PORT=8000

# ---- PostgreSQL ----
POSTGRES_DB=justice
POSTGRES_USER=justice
POSTGRES_PASSWORD=请修改为强密码

# ---- JWT ----
# Linux 生成：openssl rand -hex 32
SECRET_KEY=请修改为随机32字节以上字符串
ACCESS_TOKEN_EXPIRE_HOURS=12

# ---- 跨域 ----
CORS_ORIGINS=*

# ---- 业务数据持久化目录 ----
# Windows 本地测试：../data
# 麒麟生产环境：/opt/justice-office/data
HOST_DATA_DIR=../data

# ---- AI 推理服务（文本主模型，写作/问答都走它，vLLM） ----
# ⚠️ 强烈建议部署独立的纯文本模型，不要把 Qwen2.5-VL-7B 当主写作模型：
#    VL 模型为图像理解优化，纯文本长文写作质量差、解码慢。
# 310P 示例（4 卡跑 32B，质量/速度平衡）：
#   ASCEND_RT_VISIBLE_DEVICES=0,1,2,3 vllm serve /data/models/Qwen2.5-32B-Instruct \
#     --port 8001 --max-model-len 16384 --enable-prefix-caching
# 资源紧张时可用 Qwen2.5-14B-Instruct（单卡/双卡，不加 --enforce-eager 更快）
MODEL_SERVICE_URL=http://10.0.0.10:8001/v1
MODEL_NAME=Qwen2.5-32B-Instruct
MODEL_API_KEY=
MODEL_TIMEOUT=300
# 公文写作采样温度：越低越稳越规范（0.2~0.5），越高越发散
MODEL_TEMPERATURE=0.4
# 单次生成最大 token：公文 1800 字约需 2500+，勿低于 4096
MODEL_MAX_TOKENS=4096
MODEL_CTX_LIMIT=16384
AI_PROVIDER=auto

# ---- 视觉模型服务（可选，仅处理图片附件，Qwen2.5-VL，vLLM OpenAI 兼容端点） ----
# 配置后：对话中的图片附件直接送视觉模型；留空则走 OCR 文本通道
# 310P 部署示例（VL 在 310P 上必须 enforce-eager + float16）：
#   ASCEND_RT_VISIBLE_DEVICES=6 vllm serve /data/models/Qwen2.5-VL-7B-Instruct \
#     --enforce-eager --dtype float16 --port 8002 --max-model-len 8192
VISION_MODEL_URL=
VISION_MODEL_NAME=Qwen2.5-VL-7B-Instruct
VISION_MODEL_API_KEY=
VISION_MODEL_TIMEOUT=180
VISION_MAX_IMAGES=4

# ---- PPT 助手（DeepPresenter-9B + PPTAgent，独立部署栈见 deploy/pptagent/） ----
# PPT 大纲 / 逐页编辑专用模型（OpenAI 兼容）。留空则回退主文本模型 MODEL_*。
# 后端容器接入 justice-network 后用容器名寻址：
#   docker network connect justice-network justice-office-server
PPT_MODEL_URL=http://justice-deeppresenter-9b:8003/v1
PPT_MODEL_NAME=DeepPresenter-9B
PPT_MODEL_API_KEY=
PPT_MODEL_TIMEOUT=300
# PPTAgent Host（自管流程模式：后端编排流程，预留渲染/导出下行集成）
PPT_AGENT_URL=http://justice-ppt-host:7861

# ---- RAG ----
EMBEDDING_PROVIDER=auto
EMBED_MODEL_PATH=/data/justice/models/bge-small-zh-v1.5
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5

# ---- 公文文号 ----
DOC_NUMBER_DEFAULT_DAIZI=云司

# ---- 构建期 ----
PIP_INDEX_URL=https://pypi.org/simple
INSTALL_PPT_PREVIEW=false

# ---- 客户端预置地址 ----
# CLIENT_SERVER_URL=http://10.0.0.5:8000
