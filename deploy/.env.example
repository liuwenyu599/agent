# =============================================================================
# 智慧司法办公平台 · 生产环境变量样例
# 复制：cp .env.example .env，然后修改所有“请修改”项
# 警告：.env 含数据库口令与 JWT 密钥，禁止提交到代码仓库
# =============================================================================

# ---- 版本 ----
APP_VERSION=2.6.6

# ---- 对外端口 ----
API_PORT=8000

# ---- PostgreSQL ----
POSTGRES_DB=justice
POSTGRES_USER=justice
POSTGRES_PASSWORD=请修改为强密码

# ---- JWT ----
# Linux 生成：openssl rand -hex 32
SECRET_KEY=请修改为随机32字节以上字符串
ACCESS_TOKEN_EXPIRE_HOURS=12

# ---- 跨域 ----
CORS_ORIGINS=*

# ---- 业务数据持久化目录 ----
# Windows 本地测试：../data
# 麒麟生产环境：/opt/justice-office/data
HOST_DATA_DIR=../data

# ---- AI 推理服务（文本主模型，写作/问答都走它，vLLM） ----
# 当前生产（2026-10 起）：Qwen3.6-35B-A3B-W8A8 多模态 MoE，宿主机端口 8010，
#   由 deploy/model-pool/docker-compose.yml 管理（davinci0,1，TP=2）。
#   它一套模型同时接管文本（本节）、视觉（VISION_*）、长文（LONG_FORM_*）；
#   原 Qwen2.5-14B(:8003) 与 Qwen2.5-VL-7B(:8002) 已退役。
# 回滚到 14B（应急，见 deploy/model-pool/README.md 第 5 节）时改回：
#   MODEL_SERVICE_URL=http://10.128.85.133:8003/v1
#   MODEL_NAME=Qwen2.5-14B-Instruct
MODEL_SERVICE_URL=http://10.128.85.133:8010/v1
MODEL_NAME=Qwen3.6-35B-A3B-W8A8
MODEL_API_KEY=
MODEL_TIMEOUT=300
# 公文写作采样温度：越低越稳越规范（0.2~0.5），越高越发散
MODEL_TEMPERATURE=0.4
# 单次生成最大 token：公文 1800 字约需 2500+，勿低于 4096
MODEL_MAX_TOKENS=4096
MODEL_CTX_LIMIT=16384
AI_PROVIDER=auto

# ---- 视觉模型服务（可选，仅处理图片附件，多模态模型，vLLM OpenAI 兼容端点） ----
# 35B 主模型本身多模态：图片附件、PPT 图库图片描述都送同一个 8010 端点。
# 留空不报错，但上传的图片不会有自动描述，需在客户端补写后才能参与自动配图。
VISION_MODEL_URL=http://10.128.85.133:8010/v1
VISION_MODEL_NAME=Qwen3.6-35B-A3B-W8A8
VISION_MODEL_API_KEY=
VISION_MODEL_TIMEOUT=180
VISION_MAX_IMAGES=4
# 单次识图上限（秒）：35B 首字延迟常 >15s，设太小会让 caption 恒为空，
# 图片随后被自动配图链路过滤（表现为「传了图却从不被选用」）。
VISION_CAPTION_TIMEOUT=90

# ---- 长文生成专用网关（可选，指向 35B；后端自带 enable_thinking:false）-------
# 配置后：长文/分段写作走本网关（请求级关闭思考，与 35B 容器级
#   --default-chat-template-kwargs 双保险）；留空则长文仍走主模型 MODEL_*。
LONG_FORM_MODEL_URLS=http://10.128.85.133:8010/v1
LONG_FORM_MODEL_NAME=Qwen3.6-35B-A3B-W8A8
LONG_FORM_MODEL_TIMEOUT=600

# ---- PPT 助手（DeepPresenter-9B + PPTAgent，独立部署栈见 deploy/pptagent/） ----
# PPT 大纲 / 逐页编辑专用模型（OpenAI 兼容）。留空则回退主文本模型 MODEL_*。
# 生产环境权威地址：宿主机 10.128.85.133:8004。
# 仓库内 deploy/pptagent compose 仍可把容器内端口保持为 8003，
# 对宿主机发布为 8004；不要把生产 8003（14B 文本模型）误配给 DeepPresenter。
PPT_MODEL_URL=http://10.128.85.133:8004/v1
PPT_MODEL_NAME=DeepPresenter-9B
PPT_MODEL_API_KEY=
PPT_MODEL_TIMEOUT=300
# PPTAgent Host。生产环境通过宿主机 10.128.85.133:7861 访问。是否启用看这一项：
#   留空  → 完全走后端本地 render_pptx，行为与接入 PPTAgent 之前一字不差；
#   非空  → 「生成 / 导出」优先走 PPTAgent；失败或超时自动回退本地渲染，
#           回退产物始终是真实可打开的 pptx（不会返回空文件或占位文件）。
# 后端容器需先接入同一网络：docker network connect justice-network justice-office-server
PPT_AGENT_URL=http://10.128.85.133:7861

# ---- PPTAgent 接口契约（✅ 已真机探查确认）------------------------------
# 7861 跑的是 Gradio 聊天式 WebUI，命名端点 /send_message：
#   入参 6 个（顺序固定）：message, history, attachments,
#                        convert_type_value, template_value, num_pages_value
#   出参 5 个（顺序固定）：Chatbot / Textbox / File(list) /
#                        📥下载文件(pptx FileData) / Markdown
# 两个端点 queue=True → 提交返回 event_id，再消费 SSE 事件流取结果。
# 产物优先从返回体第 4 项取；取不到才回退扫共享卷。
# ⚠️ 部署方必读：要让 PPTAgent 真正生成 PPT，**必须走异步 job（POST /api/v1/ppt/jobs）**。
#    同步导出通道（/ppt/documents/{id}/export 等）发的是 REST 形态请求体，而 Gradio
#    命名端点只认 {"data":[6 入参]}，默认配置下该通道不可能成功，会回退后端本地渲染
#    （日志会打印明确诊断）。这是既定事实，不是故障。
# 提交地址：真机 Gradio 5 的队列提交端点（GET /gradio_api/info 返回
# openapi: DeepPresenter 5.50.0，named_endpoints 含 /send_message）。
# POST 它返回 {"event_id": ...}，再用下面的 EVENT_PATH 消费 SSE 事件流。
# ⚠️ 改这一项会同时影响异步 Job 链路和同步导出链路；后者发的是 REST 请求体，
#    配成 Gradio 路径时必失败（日志会明确提示，并回退本地渲染）。
PPT_AGENT_SUBMIT_PATH=/gradio_api/call/send_message
# 事件流地址，{event_id} 由提交响应填入；旧版 Gradio(4.x) 可改为
#   SUBMIT=/gradio_api/queue/join  +  EVENT=/gradio_api/queue/data?session_hash={session_hash}
PPT_AGENT_EVENT_PATH=/gradio_api/call/send_message/{event_id}
# 事件流句柄字段名；留空则自动探测 event_id/task_id/id
PPT_AGENT_EVENT_ID_FIELD=
# 出参索引（0-based）：3=📥 下载文件（pptx）、4=Markdown（追问/说明）
PPT_AGENT_RESULT_OUTPUT_INDEX=3
PPT_AGENT_QUESTION_OUTPUT_INDEX=4
# 入参 4/5 的枚举取值；num_pages 由大纲页数自动填（1~30 或 auto）
PPT_AGENT_CONVERT_TYPE=自由生成 (freeform)
PPT_AGENT_TEMPLATE=auto
# 附件目录映射（"后端可见目录:PPTAgent容器内目录"），留空=不传附件、材料内联进 message
PPT_AGENT_ATTACHMENT_MAP=
# 目录扫描（只用于实时进度，找不到就降级为无逐页预览）——✅ 已按真机结构核实
# 实测一个 job 目录（<日期>/<job_id>/）内含：
#   <标题>.pptx（文件名随标题动态变化，如「司法局工作汇报.pptx」）
#   .slide_images-pdf-<标题>/slide_NN.jpg（预览图，隐藏目录 + jpg + 动态目录名）
#   slides/slide_NN.html（页数基准）
# 预览图因此使用**多个候选 glob**（逗号分隔，命中任一即算数），避免目录名/
# 扩展名一变就整块失效。
PPT_AGENT_PREVIEW_GLOB=.slide_images-*/*.jpg,.slide_images-*/*.png,preview/*.jpg,preview/*.png
PPT_AGENT_SLIDE_GLOB=slides/*.html
# 健康探测路径：仅用于判断服务是否在线（200/307/404 均算在线，5xx 判不可用）。
# PPTAgent Host 的 7861 跑的是 Gradio WebUI，根路径 "/" 一定存在，故用它做探针。
# ✅ 异步 Job 链路与同步导出链路都会先探活，不要当成旧契约残留删掉。
PPT_AGENT_HEALTH_PATH=/
# ⚠️ 以下 3 项是**旧 REST 三步流程遗留**（提交 → 轮询状态 → 取结果），真机确认
# 7861 是 Gradio 之后，异步 Job 链路（/ppt/jobs）完全不使用它们：那条链路靠事件流
# 的出参直接拿产物，不轮询状态、也不另发取结果请求。
# 唯一仍在用的是同步导出的 render() 通道。保留是为了不破坏既有回退行为，
# 以及将来换真 REST 服务时留个挂载点——但不要指望配了它们能对 Gradio 生效。
# 任务 ID 字段名（留空=自动探测常见候选）
PPT_AGENT_TASK_ID_FIELD=
# 轮询状态视为完成/失败的字面量（逗号分隔，大小写不敏感）
PPT_AGENT_DONE_VALUES=succeeded,success,completed,complete,done,finished
PPT_AGENT_FAIL_VALUES=failed,failure,error,cancelled,canceled,aborted,timeout
# PPTAgent 若带鉴权则填此项（会同时下发 Authorization: Bearer 与 X-API-Key）
PPT_AGENT_API_KEY=
# 超时（秒）——按真机实测设定：PPTAgent 是聊天式 Agent，一次生成实测 5~15 分钟
# （300~900s）且要排队占 GPU。默认值必须留足余量：宁可让用户多等，也不能把正常
# 任务判超时后回退本地渲染（那样用户白等十分钟还拿不到 PPTAgent 的产物）。
# 提交：Gradio 若走 queue（/gradio_api/queue/join），入队本身也可能阻塞
PPT_AGENT_SUBMIT_TIMEOUT=60
# 单次取结果/下载：pptx 与 pdf 一起落盘，磁盘慢时也要够
PPT_AGENT_RESULT_TIMEOUT=300
# 整体预算（秒）：覆盖 15 分钟生成 + 排队等待，超时才回退本地渲染
PPT_AGENT_TOTAL_TIMEOUT=1800
# 轮询间隔（秒）：长任务不需要秒级轮询
PPT_AGENT_POLL_INTERVAL=10
# 进度扫描间隔（秒）：异步 job 扫目录更新"当前第几页"的频率
PPT_AGENT_PROGRESS_INTERVAL=5
# 无进展判失败（秒）：目录和事件流都没动静超过这个时长就判超时回退
PPT_AGENT_STALL_TIMEOUT=1800

# ---- 取结果的备用主通道：直接读共享卷里的产物文件 ----------------------
# PPTAgent 的成品落在 <workspace>/<日期>/<job_id>/<标题>.pptx。
# 若后端容器能只读挂到同一目录，则无需猜 Gradio 的结果端点，直接扫文件系统取
# 最新产物，可靠性远高于未文档化的 HTTP 契约（详见 deploy/pptagent/README 说明）。
#   留空 = 走 HTTP 通道（提交 → 轮询 → 取结果）；
#   非空 = 走文件系统通道（提交 → 扫描最新产物）。
# 仅在「后端容器与 PPTAgent 容器在同一台宿主机」时可用；不同机请留空走 HTTP。
PPT_AGENT_WORKSPACE_DIR=/data/pptagent
# 产物匹配模式（glob）。⚠️ 产物名是**随标题动态变化**的中文名，不能写死；
# 默认为通配 *.pptx，后端会在候选里挑"最新且能通过 pptx 合法性校验"的那个，
# 并自动跳过 ~$xxx.pptx 锁文件与小于 8KB 的半成品。
# （旧变量名 PPT_AGENT_RESULT_FILENAME 仍作为别名兼容）
PPT_AGENT_RESULT_GLOB=*.pptx

# ---- Draw.io MCP（PPT 视觉增强层，可选）------------------------------------
# 启用：先把 deploy/drawio-mcp 的容器启动并接入 docker 网络，再设下方 URL
#       （docker 网络内用服务名 http://drawio-mcp:3001；宿主机直连用
#       http://<宿主IP>:3001；客户端自动补 /mcp）。详见 deploy/drawio-mcp/README.md。
# 留空 → 后端 DrawioService 自动判定未启用，PPT 流程图走本地原生渲染（零侵入）。
DRAWIO_MCP_URL=
DRAWIO_MCP_TIMEOUT=30
# 产物新鲜度容错（秒），抵消两端时钟偏差
PPT_AGENT_WORKSPACE_FRESH_TOLERANCE=120

# ---- RAG ----
EMBEDDING_PROVIDER=auto
EMBED_MODEL_PATH=/data/justice/models/bge-small-zh-v1.5
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5

# ---- 公文文号 ----
DOC_NUMBER_DEFAULT_DAIZI=云司

# ---- 构建期 ----
PIP_INDEX_URL=https://pypi.org/simple
INSTALL_PPT_PREVIEW=false

# ---- 客户端预置地址 ----
# CLIENT_SERVER_URL=http://10.0.0.5:8000
