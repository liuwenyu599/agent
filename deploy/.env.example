# =============================================================================
# 智慧司法办公平台 · 生产环境变量样例
# 复制：cp .env.example .env，然后修改所有“请修改”项
# 警告：.env 含数据库口令与 JWT 密钥，禁止提交到代码仓库
# =============================================================================

# ---- 版本 ----
APP_VERSION=2.6.1

# ---- 对外端口 ----
API_PORT=8000

# ---- PostgreSQL ----
POSTGRES_DB=justice
POSTGRES_USER=justice
POSTGRES_PASSWORD=请修改为强密码

# ---- JWT ----
# Linux 生成：openssl rand -hex 32
SECRET_KEY=请修改为随机32字节以上字符串
ACCESS_TOKEN_EXPIRE_HOURS=12

# ---- 跨域 ----
CORS_ORIGINS=*

# ---- 业务数据持久化目录 ----
# Windows 本地测试：../data
# 麒麟生产环境：/opt/justice-office/data
HOST_DATA_DIR=../data

# ---- AI 推理服务（文本模型，vLLM） ----
MODEL_SERVICE_URL=http://10.0.0.10:8001/v1
MODEL_NAME=Qwen2.5-14B-Instruct
MODEL_API_KEY=
MODEL_TIMEOUT=300
MODEL_CTX_LIMIT=16384
AI_PROVIDER=auto

# ---- 视觉模型服务（可选，Qwen2.5-VL 等，vLLM OpenAI 兼容端点） ----
# 配置后：对话中的图片附件直接送视觉模型；留空则走 OCR 文本通道
# 310P 部署示例：ASCEND_RT_VISIBLE_DEVICES=6 vllm serve /data/models/Qwen2.5-VL-7B-Instruct \
#   --enforce-eager --dtype float16 --port 8002 --max-model-len 8192
VISION_MODEL_URL=
VISION_MODEL_NAME=Qwen2.5-VL-7B-Instruct
VISION_MODEL_API_KEY=
VISION_MODEL_TIMEOUT=180
VISION_MAX_IMAGES=4

# ---- RAG ----
EMBEDDING_PROVIDER=auto
EMBED_MODEL_PATH=/data/justice/models/bge-small-zh-v1.5
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5

# ---- 公文文号 ----
DOC_NUMBER_DEFAULT_DAIZI=云司

# ---- 构建期 ----
PIP_INDEX_URL=https://pypi.org/simple
INSTALL_PPT_PREVIEW=false

# ---- 客户端预置地址 ----
# CLIENT_SERVER_URL=http://10.0.0.5:8000
