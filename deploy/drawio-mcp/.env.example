# =============================================================================
# Draw.io MCP 服务环境变量样例（deploy/drawio-mcp/.env）
# 复制：cp .env.example .env   （本服务变量不多，也可直接改 docker-compose.yml）
# =============================================================================

# ---- 容器内监听端口（镜像默认 3001，一般无需改动）---------------------------
DRAWIO_MCP_PORT=3001

# ---- 内网不出网：关闭 search_shapes 对 icons.diagrams.net 的补充查询 ---------
#   形状库本体已内置镜像，设为 off 后离线可用。需要联网扩搜图标时设为空。
DRAWIO_ICON_SERVICE_URL=off

# ---- 可选：限制接受的主机名（按 Host 头校验），逗号分隔无空格 ----------------
#   留空 = 不限制（仍靠端口绑回环 / 防火墙约束可达范围）。
DRAWIO_ALLOWED_HOSTS=

# ---- 对外发布方式 -----------------------------------------------------------
#   true  = 绑 0.0.0.0（全网可达，仅在你清楚自己在做什么时开）
#   false = 仅绑 127.0.0.1（默认，最安全）
DRAWIO_PUBLISH=false
