# =============================================================================
# 模型池 Compose 环境变量（deploy/model-pool/.env）
# 复制：cp .env.example .env
# =============================================================================

# ---- 模型根目录（宿主机路径，只读挂载到容器 /models）------------------------
# 生产数据盘惯例 /data/models；与 deploy/pptagent/.env 的 HOST_MODEL_DIR 保持一致。
# 目录下需要存在：
#   qwen35b-a3b-w8a8/models/Eco-Tech--Qwen3.6-35B-A3B-w8a8/snapshots/master   （35B 权重）
#   Qwen2.5-14B-Instruct                                                      （仅回滚实例需要）
HOST_MODEL_DIR=/data/models

# ---- 35B 主模型 --------------------------------------------------------------
QWEN35B_PORT=8010
# 占用芯片（TP=2）。默认 0,1 与真机验证版本一致。
# ⚠ 改卡必须同步改 docker-compose.yml 里 qwen35b-main 的 devices 列表！
QWEN35B_DEVICES=0,1
# 容器内模型路径（相对 /models）。默认值即真机验证版本的 ModelScope 目录结构
QWEN35B_MODEL_PATH=/models/qwen35b-a3b-w8a8/models/Eco-Tech--Qwen3.6-35B-A3B-w8a8/snapshots/master

# ---- vLLM 镜像 ----------------------------------------------------------------
# 310P 专用版本（v0.23.0-310p 是现网验证版本，升级前需重新评估，勿盲目追新）
VLLM_IMAGE=m.daocloud.io/quay.io/ascend/vllm-ascend:v0.23.0-310p

# ---- 14B 应急回滚实例（profile=rollback 才启动，固定占 davinci7）--------------
QWEN14B_PORT=8003
QWEN14B_MODEL_PATH=/models/Qwen2.5-14B-Instruct

# ---- 试用模型 A：新一代 27B 多模态（profile=trial，占 davinci2,3，:8011）--------
# 权重下载到位后填写真实路径/模型名；BF16 版 TP=2，W8A8 版可 TP=1 并设 EXTRA_ARGS
QWEN38_27B_PORT=8011
QWEN38_27B_DEVICES=2,3
QWEN38_27B_TP=2
QWEN38_27B_DTYPE=bfloat16
QWEN38_27B_MODEL_PATH=/models/PLACEHOLDER-qwen38-27b
QWEN38_27B_MODEL_NAME=Qwen3.8-27B
# W8A8 量化版才需要：QWEN38_27B_EXTRA_ARGS=--quantization ascend（BF16 版严禁加）
QWEN38_27B_EXTRA_ARGS=

# ---- 试用模型 B：qwen-flash-next 轻量多模态（profile=trial，占 davinci4，:8012）-
# 默认 TP=1；权重较大需 TP=2 时改 davinci4+7 并同步 compose 的 devices 列表
QWEN_FLASH_PORT=8012
QWEN_FLASH_DEVICES=4
QWEN_FLASH_TP=1
QWEN_FLASH_DTYPE=bfloat16
QWEN_FLASH_MODEL_PATH=/models/PLACEHOLDER-qwen-flash-next
QWEN_FLASH_MODEL_NAME=Qwen-Flash-Next
QWEN_FLASH_EXTRA_ARGS=
