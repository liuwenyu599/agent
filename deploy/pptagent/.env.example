# =============================================================================
# PPT 助手部署环境变量样例（复制为 .env 后修改）
# =============================================================================

# ---- 模型服务（DeepPresenter-9B，OpenAI-compatible）----
# 生产宿主机对外端口为 8004；容器内仍监听 8003。
# CUDA：vllm/vllm-openai:latest；昇腾：quay.io/ascend/vllm-ascend:latest
PPT_LLM_IMAGE=vllm/vllm-openai:latest
# 宿主机模型权重目录（DeepPresenter-9B 放在其下）
HOST_MODEL_DIR=/data/justice/models
# 容器内模型路径 / 服务名
PPT_LLM_MODEL_PATH=/models/DeepPresenter-9B
PPT_LLM_MODEL_NAME=DeepPresenter-9B
PPT_LLM_PORT=8004
PPT_LLM_MAX_LEN=16384
# prefix caching 已在 compose 默认开启；多卡时可通过 EXTRA_ARGS 追加：
# PPT_LLM_EXTRA_ARGS=--tensor-parallel-size 2
PPT_LLM_GPU_MEM=0.85
# 追加 vllm serve 参数，例如昇腾: --enforce-eager --dtype float16
PPT_LLM_EXTRA_ARGS=

# ---- PPTAgent 镜像（官方预构建，免源码构建）----
PPT_HOST_IMAGE=forceless/deeppresenter-host:latest
PPT_SANDBOX_IMAGE=forceless/deeppresenter-sandbox:latest

# ---- Host 端口与数据 ----
PPT_HOST_PORT=7861
PPT_DATA_DIR=./data
PPT_CACHE_DIR=./cache
# 司法局内网离线部署：true（禁用联网搜索等外部工具）
PPTAGENT_OFFLINE=true
