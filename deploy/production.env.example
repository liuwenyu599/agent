# =============================================================================
# 生产 API 编排环境变量（deploy/production.env.example）
# 用法：cp production.env.example .env  → 填下面必填项 → docker compose up -d
# 配对：deploy/production.docker-compose.yml
#
# 模型地址说明：容器内访问不到 127.0.0.1 上的 vllm，必须用宿主机 LAN IP。
#   35B 主模型（model-pool 的 qwen35b-main）宿主发布 :8010。
# =============================================================================

# ---- 必填：安全（缺失则 compose 直接报错）------------------------------------
POSTGRES_PASSWORD=请改成强密码
SECRET_KEY=请改成随机长字符串

# ---- 数据库（可选，默认如下）------------------------------------------------
POSTGRES_DB=justice
POSTGRES_USER=justice

# ---- 服务端口 / 数据目录 -----------------------------------------------------
# 必填：先构建并导入镜像，再填真实标签；API 和迁移始终使用同一镜像。
SERVER_IMAGE=justice-office-server:请填写已构建的版本标签
API_PORT=8000
# 宿主机数据目录（映射到容器 /data/justice，含 SQLite/PG 无关文件/日志/上传）
HOST_DATA_DIR=/opt/justice-office/data
ACCESS_TOKEN_EXPIRE_HOURS=12
CORS_ORIGINS=*

# ---- AI 推理服务：35B 多模态主模型（model-pool :8010）-----------------------
# ⚠ 宿主 IP 按实际改（下面是内网示例 10.128.85.133）；35B 未就绪前可临时指向旧模型
MODEL_SERVICE_URL=http://10.128.85.133:8010/v1
# 多端点 + 熔断（推荐与上行一致或留空走单端点）
MODEL_SERVICE_URLS=http://10.128.85.133:8010/v1
MODEL_NAME=Qwen3.6-35B-A3B-W8A8
MODEL_API_KEY=
MODEL_TIMEOUT=300
MODEL_CTX_LIMIT=16384
MODEL_MAX_CONCURRENCY=4
AI_PROVIDER=auto

# 视觉：35B 多模态接管图片理解（指同一端点）；留空则回退 OCR 文本通道
VISION_MODEL_URL=http://10.128.85.133:8010/v1
VISION_MODEL_NAME=Qwen3.6-35B-A3B-W8A8

# 长文正文生成：显式走 35B（关思考双保险）；留空回退主模型
LONG_FORM_MODEL_URLS=http://10.128.85.133:8010/v1
LONG_FORM_MODEL_NAME=Qwen3.6-35B-A3B-W8A8
LONG_FORM_MODEL_TIMEOUT=300

# ---- RAG / Embedding --------------------------------------------------------
EMBEDDING_PROVIDER=auto
EMBED_MODEL_PATH=/data/justice/models/bge-small-zh-v1.5
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5

# ---- 写作 -------------------------------------------------------------------
WRITING_AUTO_QA=true
WRITING_AGENT_GRAPH_ENABLED=false
WRITING_AGENT_ROLLOUT_PERCENT=0
WRITING_AGENT_GRAPH_COMPLEX_ONLY=true
WRITING_AGENT_MAX_TOOL_ROUNDS=4
WRITING_AGENT_MAX_REPAIR_ROUNDS=2
WRITING_AGENT_RUN_TIMEOUT_SECONDS=300
WRITING_AGENT_TRACE_RETENTION_DAYS=180
DOC_NUMBER_DEFAULT_DAIZI=云司

# ---- PPT -------------------------------------------------------------------
# 当前使用本地原生 PPTX 渲染器，文本规划复用 35B；留空可确保不会调用 PPTAgent。
PPT_MODEL_URL=http://10.128.85.133:8010/v1
PPT_MODEL_NAME=Qwen3.6-35B-A3B-W8A8
PPT_AGENT_ENABLED=false
PPT_AGENT_URL=
OCR_ENABLED=false

# ---- Draw.io MCP（PPT 视觉增强层，可选）------------------------------------
# 启用：先把 deploy/drawio-mcp 的容器挂到 justice-net（见其 README），
#       再设 DRAWIO_MCP_URL=http://drawio-mcp:3001（base，客户端自动补 /mcp）。
# 留空 → 后端 DrawioService 自动判定未启用，PPT 流程图走本地原生渲染（零侵入）。
DRAWIO_MCP_URL=
DRAWIO_MCP_TIMEOUT=30
