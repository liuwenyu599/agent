# ============================================================
# 正则规则
# ============================================================

PATTERNS = {

    # 广东政府文件编号
    "file_number": [
        r"粤府〔\d{4}〕\d+号",
        r"粤府办〔\d{4}〕\d+号",
        r"粤府函〔\d{4}〕\d+号",
        r"粤府规〔\d{4}〕\d+号",
        r"粤司〔\d{4}〕\d+号",
        r"粤司办〔\d{4}〕\d+号",
        r"〔\d{4}〕\d+号",
    ],

    # 日期
    "date": [
        r"\d{4}年\d{1,2}月\d{1,2}日",
        r"\d{4}年\d{1,2}月",
        r"\d{4}年",
    ],

    # 广东政府机构
    "organization": [
        r"广东省人民政府",
        r"广东省人民政府办公厅",
