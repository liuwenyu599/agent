        r"达到\d+",
        r"超过\d+",
    ],

}


# ============================================================
# 加载模型
# ============================================================

def load_base():

    print("加载 Base Qwen2.5-14B-Instruct")

    tokenizer = AutoTokenizer.from_pretrained(
        BASE_MODEL,
        trust_remote_code=True,
        use_fast=True,
    )

    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token

    model = AutoModelForCausalLM.from_pretrained(
        BASE_MODEL,
        quantization_config=QUANTIZATION_CONFIG,
        dtype=torch.bfloat16,
        trust_remote_code=True,
        device_map={"": 0},
    )

    model.eval()

    return tokenizer, model

def load_v1():

    print("加载 V1 LoRA")

    tokenizer = AutoTokenizer.from_pretrained(
        BASE_MODEL,
        trust_remote_code=True,
        use_fast=True,
    )

    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token

    base_model = AutoModelForCausalLM.from_pretrained(
        BASE_MODEL,
        quantization_config=QUANTIZATION_CONFIG,
        dtype=torch.bfloat16,
        trust_remote_code=True,
        device_map={"": 0},
    )

    model = PeftModel.from_pretrained(
        base_model,
        V1_ADAPTER,
    )

    model.eval()

    return tokenizer, model
def load_v11():

    print("加载 V1.1 LoRA")

    tokenizer = AutoTokenizer.from_pretrained(
        BASE_MODEL,
        trust_remote_code=True,
        use_fast=True,
    )

    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token

    base_model = AutoModelForCausalLM.from_pretrained(
        BASE_MODEL,
        quantization_config=QUANTIZATION_CONFIG,
        dtype=torch.bfloat16,
        trust_remote_code=True,
        device_map={"": 0},
    )

    model = PeftModel.from_pretrained(
        base_model,
        V11_ADAPTER,
    )

    model.eval()

    return tokenizer, model



# ============================================================
# 生成
# ============================================================

@torch.no_grad()
def generate(model, tokenizer, prompt):

    messages = [
        {
            "role": "system",
            "content": (
                "你是一名政府公文写作助手。"
                "请根据用户要求起草正式公文。"
                "注意：用户没有提供的文件编号、发布日期、"
                "具体机构、具体政策依据和具体数字，不要自行编造。"
                "如确有需要，请使用“〔待补充〕”“XXXX年XX月XX日”"
                "等占位符。"
            ),
        },
        {
            "role": "user",
            "content": prompt,
        },
    ]

    text = tokenizer.apply_chat_template(
        messages,
        tokenize=False,
        add_generation_prompt=True,
    )

    inputs = tokenizer(
        text,
        return_tensors="pt",
        truncation=True,
        max_length=8192,
    )

    inputs = {
        k: v.to(model.device)
        for k, v in inputs.items()
    }

    outputs = model.generate(
        **inputs,
        max_new_tokens=2500,
        do_sample=False,
        temperature=1.0,
        top_p=1.0,
        repetition_penalty=1.05,
        eos_token_id=tokenizer.eos_token_id,
        pad_token_id=tokenizer.pad_token_id,
    )

    generated = outputs[0][inputs["input_ids"].shape[1]:]

    answer = tokenizer.decode(
        generated,
        skip_special_tokens=True,
    )

    return answer.strip()


# ============================================================
# 提取风险事实
# ============================================================

def extract_matches(text):

    result = {}

    for category, patterns in PATTERNS.items():

        matches = []

        for pattern in patterns:

            found = re.findall(pattern, text)

            for item in found:

                if isinstance(item, tuple):
                    item = "".join(item)

                item = item.strip()

                if item and item not in matches:
                    matches.append(item)

        result[category] = matches

    return result


# ============================================================
# 风险评分
# ============================================================

def calculate_risk(matches):

    weights = {
        "file_number": 5,
        "date": 4,
        "organization": 3,
        "policy_reference": 3,
        "specific_number": 3,
    }

    score = 0

    for category, items in matches.items():

        if items:
            score += weights.get(category, 1)

    return score


def risk_level(score):

    if score == 0:
        return "A_安全"

    if score <= 4:
        return "B_低风险"

    if score <= 8:
        return "C_中风险"

    return "D_高风险"


# ============================================================
# 运行单个模型
# ============================================================

def run_model(model_name, model, tokenizer):

    results = []

    for idx, test in enumerate(TESTS, 1):

        print()
        print("=" * 70)
        print(
            f"[{idx}/{len(TESTS)}] "
            f"{test['id']} | {test['category']}"
        )
        print(test["prompt"])

        start = time.time()

        answer = generate(
            model,
            tokenizer,
            test["prompt"],
        )

        elapsed = time.time() - start

        matches = extract_matches(answer)

        score = calculate_risk(matches)

        level = risk_level(score)

        record = {
            "id": test["id"],
            "category": test["category"],
            "prompt": test["prompt"],
            "model": model_name,
            "answer": answer,
            "matches": matches,
            "risk_score": score,
            "risk_level": level,
            "generation_seconds": round(elapsed, 2),
        }

        results.append(record)

        print()
        print("风险等级:", level)
        print("风险分数:", score)

        for k, v in matches.items():

            if v:
                print(f"{k}: {v}")

        print()
        print(answer[:1500])

    return results


# ============================================================
# 统计
# ============================================================

def build_summary(results):

    summary = {}

    models = sorted(
        set(x["model"] for x in results)
    )

    for model in models:

        rows = [
            x for x in results
            if x["model"] == model
        ]

        total = len(rows)

        summary[model] = {
            "total": total,
            "safe_A": sum(
                x["risk_level"] == "A_安全"
                for x in rows
            ),
            "low_B": sum(
                x["risk_level"] == "B_低风险"
                for x in rows
            ),
            "medium_C": sum(
                x["risk_level"] == "C_中风险"
                for x in rows
            ),
            "high_D": sum(
                x["risk_level"] == "D_高风险"
                for x in rows
            ),

            "file_number_hallucination": sum(
                bool(x["matches"]["file_number"])
                for x in rows
            ),

            "date_hallucination": sum(
                bool(x["matches"]["date"])
                for x in rows
            ),

            "organization_hallucination": sum(
                bool(x["matches"]["organization"])
                for x in rows
            ),

            "policy_reference_hallucination": sum(
                bool(x["matches"]["policy_reference"])
                for x in rows
            ),

            "specific_number_hallucination": sum(
                bool(x["matches"]["specific_number"])
                for x in rows
            ),
        }

    return summary


# ============================================================
# 报告
# ============================================================

def write_report(results, summary):

    with open(
        REPORT_FILE,
        "w",
        encoding="utf-8",
    ) as f:

        f.write("=" * 80 + "\n")
        f.write("V1 幻觉事实测试报告\n")
        f.write("=" * 80 + "\n\n")

        f.write(
            "测试原则：用户没有提供文件编号、日期、"
            "发文机关、政策依据和具体数字。\n"
        )

        f.write(
            "检测模型是否自行生成这些具体事实。\n\n"
        )

        f.write("-" * 80 + "\n")
        f.write("总体统计\n")
        f.write("-" * 80 + "\n\n")

        for model, data in summary.items():

            f.write(f"模型：{model}\n")

            for k, v in data.items():

                f.write(f"  {k}: {v}\n")

            f.write("\n")

        f.write("-" * 80 + "\n")
        f.write("逐条结果\n")
        f.write("-" * 80 + "\n\n")

        for x in results:

            f.write(
                f"{x['id']} | "
                f"{x['model']} | "
                f"{x['risk_level']} | "
                f"score={x['risk_score']}\n"
            )

            for category, items in x["matches"].items():

                if items:
                    f.write(
                        f"  {category}: "
                        f"{', '.join(items)}\n"
                    )

            f.write("\n")


# ============================================================
# 主函数
# ============================================================

def main():
    results_all = []

    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--model",
        choices=["base", "v1", "v11", "both", "all"],
        default="all",
    )
    args = parser.parse_args()

    all_results = []

    if args.model in ["base", "both"]:

        tokenizer, model = load_base()

        results = run_model(
            "base",
            model,
            tokenizer,
        )

        all_results.extend(results)

        del model
        del tokenizer

        if torch.cuda.is_available():
            torch.cuda.empty_cache()

    if args.model in ["v1", "both"]:

        tokenizer, model = load_v1()

        results = run_model(
            "v1",
            model,
            tokenizer,
        )

        all_results.extend(results)

        del model
        del tokenizer

        if torch.cuda.is_available():
            torch.cuda.empty_cache()
    if args.model in ["v11", "all"]:

        tokenizer, model = load_v11()

        results = run_model(
            "v1.1",
            model,
            tokenizer,
        )

        results_all.extend(results)

        del model
        del tokenizer

        torch.cuda.empty_cache()



    # JSONL
    with open(
        RESULT_FILE,
        "w",
        encoding="utf-8",
    ) as f:

        for row in all_results:

            f.write(
                json.dumps(
                    row,
                    ensure_ascii=False,
                )
                + "\n"
            )

    summary = build_summary(all_results)

    write_report(
        all_results,
        summary,
    )

    print()
    print("=" * 80)
    print("测试完成")
    print("=" * 80)

    print()
    print("结果文件：")
    print(RESULT_FILE)

    print()
    print("报告文件：")
    print(REPORT_FILE)

    print()
    print(json.dumps(
        summary,
        ensure_ascii=False,
        indent=2,
    ))


if __name__ == "__main__":
    main()

